&CONTROL
      calculation = 'scf',
      etot_conv_thr = 2d-05,
      forc_conv_thr = 0.0001,
      outdir = './out/',
      prefix = 'aiida',
      pseudo_dir = './pseudo/',
      tprnfor = .TRUE.,
      tstress = .TRUE.,
      verbosity = 'high',
/
&SYSTEM
      degauss = 0.02,
      ecutrho = 360.0,
      ecutwfc = 45.0,
      ibrav = 0,
      nat = 2,
      nosym = .FALSE.,
      ntyp = 1,
      occupations = 'smearing',
      smearing = 'cold',
/
&ELECTRONS
      conv_thr = 4d-10,
      electron_maxstep = 80,
      mixing_beta = 0.4,
/
&IONS
/
&CELL
/
ATOMIC_SPECIES
      Ge  72.6400 ge_pbesol_v1.4.uspp.F.UPF
ATOMIC_POSITIONS crystal
      Ge 0.5000000000 0.5000000000 0.5000000000
      Ge 0.7500000000 0.7500000000 0.7500000000
K_POINTS automatic
      13 13 13 0 0 0
CELL_PARAMETERS angstrom
      -0.1026370934 2.8912558304 3.0694816052
      2.6481956039 -0.0367105951 2.8502015048
      2.7886495650 2.7473586097 0.0384585653