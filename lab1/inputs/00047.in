&CONTROL
      calculation = 'scf',
      etot_conv_thr = 2d-05,
      forc_conv_thr = 0.0001,
      outdir = './out/',
      prefix = 'aiida',
      pseudo_dir = './pseudo/',
      tprnfor = .TRUE.,
      tstress = .TRUE.,
      verbosity = 'high',
/
&SYSTEM
      degauss = 0.02,
      ecutrho = 360.0,
      ecutwfc = 45.0,
      ibrav = 0,
      nat = 2,
      nosym = .FALSE.,
      ntyp = 1,
      occupations = 'smearing',
      smearing = 'cold',
/
&ELECTRONS
      conv_thr = 4d-10,
      electron_maxstep = 80,
      mixing_beta = 0.4,
/
&IONS
/
&CELL
/
ATOMIC_SPECIES
      Ge  72.6400 ge_pbesol_v1.4.uspp.F.UPF
ATOMIC_POSITIONS crystal
      Ge 0.5000000000 0.5000000000 0.5000000000
      Ge 0.7500000000 0.7500000000 0.7500000000
K_POINTS automatic
      13 13 13 0 0 0
CELL_PARAMETERS angstrom
      0.1272381517 2.8314241111 2.8356212130
      2.8408432877 -0.0409041871 3.0308709922
      3.0006079009 2.8622265622 -0.0783716692